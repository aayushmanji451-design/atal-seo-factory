<?xml version="1.0"?>
<ruleset name="ATAL SEO Factory">
    <description>WordPress Coding Standards for the ATAL SEO Factory monorepo.</description>

    <arg name="basepath" value="."/>
    <arg name="colors"/>
    <arg name="extensions" value="php"/>
    <arg name="parallel" value="8"/>

    <file>packages</file>
    <file>plugins</file>
    <file>tests</file>
    <file>tools</file>

    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/tests/Support/WordPressStubs.php</exclude-pattern>

    <rule ref="WordPress">
        <exclude name="WordPress.Files.FileName.InvalidClassFileName"/>
        <exclude name="WordPress.Files.FileName.NotHyphenatedLowercase"/>
    </rule>

    <rule ref="WordPress.Files.FileName.InvalidClassFileName">
        <exclude-pattern>*/tests/*Test.php</exclude-pattern>
    </rule>

    <rule ref="WordPress.Files.FileName.NotHyphenatedLowercase">
        <exclude-pattern>*/tests/*Test.php</exclude-pattern>
    </rule>

    <!-- Runtime-neutral contracts and CLI tools do not execute inside WordPress. -->
    <rule ref="WordPress.Security.EscapeOutput">
        <exclude-pattern>*/packages/contracts/*</exclude-pattern>
        <exclude-pattern>*/tools/*</exclude-pattern>
        <exclude-pattern>*/plugins/atal-seo-factory-core/src/Application/*</exclude-pattern>
        <exclude-pattern>*/plugins/atal-seo-factory-core/src/Infrastructure/*</exclude-pattern>
		<exclude-pattern>*/plugins/atal-diploma-receiver/src/Application/*</exclude-pattern>
		<exclude-pattern>*/plugins/atal-diploma-receiver/src/Domain/*</exclude-pattern>
		<exclude-pattern>*/plugins/atal-diploma-receiver/src/Infrastructure/*</exclude-pattern>
		<exclude-pattern>*/plugins/atal-diploma-receiver/src/Rest/*</exclude-pattern>
    </rule>

    <rule ref="WordPress.WP.AlternativeFunctions.file_system_operations_fwrite">
        <exclude-pattern>*/packages/contracts/src/Cli/*</exclude-pattern>
        <exclude-pattern>*/tools/*</exclude-pattern>
    </rule>

    <rule ref="WordPress.WP.AlternativeFunctions.file_get_contents_file_get_contents">
        <exclude-pattern>*/packages/contracts/*</exclude-pattern>
    </rule>

    <rule ref="WordPress.WP.AlternativeFunctions.json_encode_json_encode">
        <exclude-pattern>*/packages/contracts/*</exclude-pattern>
        <exclude-pattern>*/plugins/atal-seo-factory-core/src/Application/Import/*</exclude-pattern>
    </rule>

	<!-- Standalone build/smoke CLI tools intentionally operate before WordPress loads. -->
	<rule ref="WordPress.WP.AlternativeFunctions">
		<exclude-pattern>*/tools/*</exclude-pattern>
	</rule>

    <!-- PHPCS does not understand PHPStan list/shape annotations on array parameters. -->
    <rule ref="Squiz.Commenting.FunctionComment.IncorrectTypeHint">
        <exclude-pattern>*/packages/contracts/*</exclude-pattern>
        <exclude-pattern>*/plugins/atal-seo-factory-core/*</exclude-pattern>
		<exclude-pattern>*/plugins/atal-diploma-receiver/*</exclude-pattern>
        <exclude-pattern>*/tests/*</exclude-pattern>
    </rule>

    <rule ref="Squiz.Commenting.FunctionCommentThrowTag.Missing">
        <exclude-pattern>*/packages/contracts/*</exclude-pattern>
        <exclude-pattern>*/plugins/atal-seo-factory-core/*</exclude-pattern>
		<exclude-pattern>*/plugins/atal-diploma-receiver/*</exclude-pattern>
        <exclude-pattern>*/tests/*</exclude-pattern>
    </rule>

    <!-- Inline PHPStan @var assertions are intentionally one-line docblocks. -->
    <rule ref="Generic.Commenting.DocComment.MissingShort">
        <exclude-pattern>*/packages/contracts/*</exclude-pattern>
        <exclude-pattern>*/plugins/atal-seo-factory-core/*</exclude-pattern>
		<exclude-pattern>*/plugins/atal-diploma-receiver/*</exclude-pattern>
        <exclude-pattern>*/tests/*</exclude-pattern>
    </rule>

    <!-- Interface implementations and isolated test doubles inherit contract documentation. -->
    <rule ref="Squiz.Commenting.FunctionComment.Missing">
        <exclude-pattern>*/plugins/atal-seo-factory-core/*</exclude-pattern>
		<exclude-pattern>*/plugins/atal-diploma-receiver/*</exclude-pattern>
        <exclude-pattern>*/tests/*</exclude-pattern>
    </rule>

    <rule ref="Squiz.Commenting.FunctionComment.MissingParamTag">
        <exclude-pattern>*/plugins/atal-seo-factory-core/*</exclude-pattern>
		<exclude-pattern>*/plugins/atal-diploma-receiver/*</exclude-pattern>
    </rule>

    <rule ref="Squiz.Commenting.FunctionCommentThrowTag.WrongNumber">
        <exclude-pattern>*/plugins/atal-seo-factory-core/*</exclude-pattern>
    </rule>

    <rule ref="Squiz.Commenting.VariableComment.Missing">
        <exclude-pattern>*/tests/Support/*</exclude-pattern>
    </rule>

	<!-- Task 03 uses PSR-4 one-class files in production; isolated acceptance/test doubles stay local to their runner. -->
	<rule ref="Generic.Files.OneObjectStructurePerFile.MultipleFound">
		<exclude-pattern>*/plugins/atal-diploma-receiver/src/Application/Acceptance/*</exclude-pattern>
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>

	<rule ref="Squiz.Commenting.ClassComment.Missing">
		<exclude-pattern>*/plugins/atal-diploma-receiver/*</exclude-pattern>
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>

	<rule ref="Squiz.Commenting.FileComment.MissingPackageTag">
		<exclude-pattern>*/plugins/atal-diploma-receiver/*</exclude-pattern>
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>

	<rule ref="Squiz.Commenting.FileComment.SpacingAfterComment">
		<exclude-pattern>*/plugins/atal-diploma-receiver/*</exclude-pattern>
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>

	<rule ref="Squiz.Commenting.FunctionComment">
		<exclude-pattern>*/plugins/atal-diploma-receiver/*</exclude-pattern>
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>

	<rule ref="Squiz.Commenting.VariableComment.Missing">
		<exclude-pattern>*/plugins/atal-diploma-receiver/src/Application/Acceptance/*</exclude-pattern>
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>

	<rule ref="WordPress.WP.AlternativeFunctions.json_encode_json_encode">
		<exclude-pattern>*/plugins/atal-diploma-receiver/src/Application/Acceptance/*</exclude-pattern>
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>

	<rule ref="WordPress.PHP.YodaConditions.NotYoda">
		<exclude-pattern>*/plugins/atal-diploma-receiver/src/Application/Acceptance/*</exclude-pattern>
	</rule>

	<!-- The receiver's deterministic duplicate lookup is an indexed, two-row bounded ownership query. -->
	<rule ref="WordPress.DB.SlowDBQuery">
		<exclude-pattern>*/plugins/atal-diploma-receiver/src/Infrastructure/WordPress/WordPressDraftPostService.php</exclude-pattern>
	</rule>
</ruleset>
