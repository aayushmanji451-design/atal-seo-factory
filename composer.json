{
    "name": "atal/seo-factory",
    "description": "Development foundation for the ATAL SEO Factory WordPress monorepo.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.1"
    },
    "require-dev": {
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^10.5",
        "wp-coding-standards/wpcs": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Atal\\SeoFactory\\": "plugins/atal-seo-factory-core/src/",
            "Atal\\DiplomaReceiver\\": "plugins/atal-diploma-receiver/src/",
            "Atal\\Contracts\\": "packages/contracts/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Atal\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "phpcs": "@php vendor/bin/phpcs --standard=phpcs.xml.dist",
        "phpstan": "@php vendor/bin/phpstan analyse --configuration=phpstan.neon --no-progress",
        "phpunit": "@php vendor/bin/phpunit --configuration=phpunit.xml.dist",
        "validate-knowledge": "@php tools/validate-knowledge.php",
        "test": [
            "@phpcs",
            "@phpstan",
            "@phpunit",
            "@validate-knowledge"
        ]
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
